        return

    if user_id not in active_chats:
        send(
            user_id,
            "ℹ️ شما چت فعالی ندارید.",
            MAIN_MENU
        )
        return

    other = active_chats.get(user_id)

    del active_chats[user_id]

    if other in active_chats:
        del active_chats[other]

    send(
        user_id,
        "🛑 چت پایان یافت.",
        MAIN_MENU
    )

    if other is not None:
        send(
            other,
            "🛑 طرف مقابل چت را پایان داد.",
            MAIN_MENU
        )


